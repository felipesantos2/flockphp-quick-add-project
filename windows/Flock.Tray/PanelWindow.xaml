<Window
    x:Class="Flock.Tray.PanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Flock.Tray">
    <ScrollViewer
        x:Name="Scroller"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Root" Spacing="12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Image x:Name="TrayIcon" Width="26" Height="26" />
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{Binding Headline}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <ProgressRing
                    Grid.Column="1"
                    Width="16"
                    Height="16"
                    IsActive="True"
                    Visibility="{Binding RestartVisibility}" />
            </Grid>

            <Grid Visibility="{Binding UpdateVisibility}" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="{StaticResource GlyphDownload}" FontFamily="{StaticResource SymbolsFont}" FontSize="14"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding UpdateMessage}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Content="{l:Loc Key=Common_Update}" Command="{Binding InstallUpdateCommand}" Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{Binding CanInstallUpdate}" />
            </Grid>

            <InfoBar
                Title=""
                Message="{Binding ActionError}"
                IsOpen="{Binding HasActionError}"
                IsClosable="True"
                Severity="Error"
                CloseButtonClick="DismissError" />

            <StackPanel Spacing="12" Visibility="{Binding StatusContentVisibility}">
                <StackPanel Spacing="4" Visibility="{Binding WarningsVisibility}">
                    <ItemsControl ItemsSource="{Binding Status.Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{StaticResource GlyphWarning}" FontFamily="{StaticResource SymbolsFont}" FontSize="12"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="-16,0" />

                <StackPanel Spacing="5">
                    <TextBlock Text="{l:Loc Key=Logs_ServicesHeading}" Style="{StaticResource CaptionTextBlockStyle}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ItemsControl ItemsSource="{Binding Services}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource StatusDotStyle}" Fill="{Binding StatusBrush}" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="210" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="-16,0" />

                <StackPanel Spacing="4">
                    <TextBlock Text="{l:Loc Key=Logs_SitesHeading}" Style="{StaticResource CaptionTextBlockStyle}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Text="{l:Loc Key=Menu_NoSites}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="{Binding EmptySitesVisibility}" />
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Visibility="{Binding SitesVisibility}">
                        <StackPanel Spacing="2">
                        <ItemsControl ItemsSource="{Binding Sites}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2">
                                        <Grid ColumnSpacing="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="6,4"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                IsEnabled="{Binding HasUrl}"
                                                ToolTipService.ToolTip="{Binding SiteTooltip}"
                                                Click="OpenSite">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="{Binding SecurityGlyph}" FontFamily="{StaticResource SymbolsFont}" FontSize="12"
                                                                  Foreground="{Binding SecurityBrush}" />
                                                        <TextBlock Text="{Binding Domain}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <!-- A problem as an icon, as in Settings → Sites; the tooltip says what. -->
                                                        <FontIcon Glyph="&#xE7BA;" FontFamily="{StaticResource SymbolsFont}" FontSize="12"
                                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}" ToolTipService.ToolTip="{Binding Problem}"
                                                                  Visibility="{Binding ProblemVisibility}" />
                                                        <FontIcon Glyph="{StaticResource GlyphBug}" FontFamily="{StaticResource SymbolsFont}" FontSize="12"
                                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{Binding DebuggingVisibility}" />
                                                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="7,1,7,2"
                                                                Visibility="{Binding FrankenPhpVisibility}">
                                                            <TextBlock Text="{Binding WorkerLabel}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </Border>
                                                        <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="8" Padding="7,1,7,2"
                                                                Visibility="{Binding SharedVisibility}" ToolTipService.ToolTip="{Binding ShareTooltip}">
                                                            <TextBlock Text="{l:Loc Key=Sites_Shared}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                        </Border>
                                                        <Ellipse Width="6" Height="6" Fill="{Binding DotBrush}" VerticalAlignment="Center"
                                                                 ToolTipService.ToolTip="{Binding DotTooltip}" Visibility="{Binding DotVisibility}" />
                                                        <TextBlock Text="{Binding PhpLabel}" Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                            <!-- A site with worktrees: how many, and a toggle that shows them under it. -->
                                            <Button
                                                Grid.Column="1"
                                                Padding="6,4"
                                                VerticalAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Visibility="{Binding ToggleVisibility}"
                                                ToolTipService.ToolTip="{Binding ToggleLabel}"
                                                AutomationProperties.Name="{Binding ToggleLabel}"
                                                Click="ToggleWorktrees">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding WorktreeCount}" Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <FontIcon Glyph="{Binding ToggleGlyph}" FontFamily="{StaticResource SymbolsFont}" FontSize="10"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Worktrees}" Visibility="{Binding WorktreesVisibility}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button
                                                        Margin="20,0,0,2"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        Padding="6,4"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        IsEnabled="{Binding HasUrl}"
                                                        ToolTipService.ToolTip="{Binding Tooltip}"
                                                        Click="OpenWorktree">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <FontIcon Glyph="{Binding SecurityGlyph}" FontFamily="{StaticResource SymbolsFont}" FontSize="12"
                                                                          Foreground="{Binding SecurityBrush}" />
                                                                <StackPanel Spacing="0">
                                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Message}" Style="{StaticResource CaptionTextBlockStyle}"
                                                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                                                                               Visibility="{Binding MessageVisibility}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="7,1,7,2"
                                                                        Visibility="{Binding DatabaseVisibility}" ToolTipService.ToolTip="{Binding DatabaseTooltip}">
                                                                    <TextBlock Text="{Binding DatabaseLabel}" FontSize="11" FontWeight="SemiBold"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </Border>
                                                                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{Binding StepVisibility}">
                                                                    <ProgressRing Width="12" Height="12" />
                                                                    <TextBlock Text="{Binding Step}" Style="{StaticResource CaptionTextBlockStyle}" MaxWidth="150"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Proxies (flock proxy) follow the sites. -->
                        <ItemsControl ItemsSource="{Binding Proxies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="6,4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        IsEnabled="{Binding HasUrl}"
                                        ToolTipService.ToolTip="{Binding Tooltip}"
                                        Click="OpenProxy">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="{Binding SecurityGlyph}" FontFamily="{StaticResource SymbolsFont}" FontSize="12"
                                                          Foreground="{Binding SecurityBrush}" />
                                                <TextBlock Text="{Binding Domain}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE7BA;" FontFamily="{StaticResource SymbolsFont}" FontSize="12"
                                                          Foreground="{ThemeResource SystemFillColorCautionBrush}" ToolTipService.ToolTip="{Binding Problem}"
                                                          Visibility="{Binding ProblemVisibility}" />
                                                <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding ServerLabel}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="-16,0" />

                <StackPanel Spacing="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{StaticResource GlyphBug}" FontFamily="{StaticResource SymbolsFont}" FontSize="14" />
                            <TextBlock Text="Xdebug" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{Binding Xdebug, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{StaticResource GlyphDownload}" FontFamily="{StaticResource SymbolsFont}" FontSize="14" />
                            <TextBlock Text="{l:Loc Key=Menu_CaptureDumps}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{Binding Dumps, Mode=TwoWay}" IsEnabled="{Binding CaptureEnabled}" OnContent="" OffContent="" MinWidth="0" />
                    </Grid>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="-16,0" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding OpenMailCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,8">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <FontIcon Glyph="{StaticResource GlyphMail}" FontFamily="{StaticResource SymbolsFont}" FontSize="18" />
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="{l:Loc Key=Menu_Mail}" FontSize="12" />
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="6,1"
                                        Visibility="{Binding MailCountVisibility}">
                                    <TextBlock Text="{Binding MailCount}" FontSize="11" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Command="{Binding OpenDumpsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,8">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <FontIcon Glyph="{StaticResource GlyphBug}" FontFamily="{StaticResource SymbolsFont}" FontSize="18" />
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="{l:Loc Key=Menu_Dumps}" FontSize="12" />
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="6,1"
                                        Visibility="{Binding DumpCountVisibility}">
                                    <TextBlock Text="{Binding DumpCount}" FontSize="11" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Command="{Binding OpenLogsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,8">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <FontIcon Glyph="{StaticResource GlyphDocument}" FontFamily="{StaticResource SymbolsFont}" FontSize="18" />
                            <TextBlock Text="{l:Loc Key=Menu_Logs}" FontSize="12" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="8" Visibility="{Binding NotRunningVisibility}">
                <StackPanel Spacing="8" Visibility="{Binding SetupVisibility}">
                    <TextBlock Text="{l:Loc Key=Menu_NotSetUp}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <Button Content="{l:Loc Key=Menu_SetUpFlock}" Command="{Binding OpenSetupCommand}" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
                <StackPanel Spacing="8" Visibility="{Binding UpdatingVisibility}">
                    <TextBlock Text="{l:Loc Key=Menu_Updating}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressBar IsIndeterminate="True" />
                </StackPanel>
                <StackPanel Spacing="8" Visibility="{Binding StoppedVisibility}">
                    <TextBlock Text="{Binding NotRunningMessage}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <Button Content="{l:Loc Key=Menu_StartFlock}" Command="{Binding RestartCommand}" Style="{StaticResource AccentButtonStyle}" IsEnabled="{Binding StartEnabled}" />
                </StackPanel>
            </StackPanel>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <HyperlinkButton Content="{l:Loc Key=Menu_Restart}" Command="{Binding RestartCommand}" Padding="4,2" Visibility="{Binding FooterVisibility}"
                                     IsEnabled="{Binding RestartEnabled}" />
                    <HyperlinkButton Content="{l:Loc Key=Menu_Settings}" Command="{Binding OpenSettingsCommand}" Padding="4,2" />
                </StackPanel>
                <HyperlinkButton Grid.Column="1" Content="{l:Loc Key=Menu_QuitFlock}" Command="{Binding QuitCommand}" Padding="4,2" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
